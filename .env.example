# Mayim — copy to .env.local and fill in what you have.
# Every key is optional; the app degrades explicitly without each one (see README → Environment).

# Public: satellite basemap, globe, client geocoding. Restrict it by URL in the Mapbox dashboard.
NEXT_PUBLIC_MAPBOX_ACCESS_TOKEN=

# Server-only: keeps geocoding off the public token.
MAPBOX_SECRET_TOKEN=

# Server-only: live research (4 evidence queries + 1 partner query per run). https://dashboard.exa.ai/api-keys
EXA_API_KEY=

# Server-only: structures retrieved sources into scored findings and writes the summary.
# Without it, live sources are still shown as verbatim excerpts.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini
